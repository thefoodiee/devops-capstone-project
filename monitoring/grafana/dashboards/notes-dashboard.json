      "id": 3,
      "title": "Application Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"notes_app\"}",
          "legendFormat": "App Up (1=Healthy)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "title": "HTTP Requests Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(notes_http_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "title": "Request Duration (p95 seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(notes_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ]
    }
